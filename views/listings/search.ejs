
<% layout("/layouts/boilerplate") %>
<head>
    <link rel="stylesheet" href="/css/search.css">

</head>
<div class="search-container">
    <h2 class="search-title">Search Results for "<%= query %>"</h2>

    <% if (listings.length === 0) { %>
        <p class="no-results">No listings found matching your search.</p>
    <% } else { %>
        <div class="row">
            <% listings.forEach(listing => { %>
                <a href="/listings/<%= listing._id %>" class="listing-card">
                    <img src="<%= listing.image.url %>" alt="Listing Image">
                    <div class="card-body">
                        <h5 class="card-title"><%= listing.title %></h5>
                        <p class="card-text"><strong>Location:</strong> <%= listing.location %></p>
                        <p class="card-text"><strong>Country:</strong> <%= listing.country %></p>
                        <button class="btn btn-primary">View Details</button>
                    </div>
                </a>
            <% }) %>
        </div>
    <% } %>
</div>
